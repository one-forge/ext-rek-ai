{
    "name": "one-forge/rek-ai",
    "description": "A extension to include the rek.ai service into your TYPO3 website",
    "type": "typo3-cms-extension",
    "license": [
        "GPL-2.0-or-later"
    ],
    "require": {
        "php": "^8.1",
        "typo3/cms-core": "^12.4 || ^13.4"
    },
    "require-dev": {
        "typo3/testing-framework": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "OneForge\\RekAi\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OneForge\\RekAi\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "one_forge_rekai"
        }
    }
}